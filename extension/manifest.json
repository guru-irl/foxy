{
  "manifest_version": 3,
  "name": "Foxy",
  "version": "2.1.2",
  "description": "A kanban board of your tabs and tab groups, shared across devices through bookmarks.",
  "permissions": ["tabs", "tabGroups", "bookmarks", "storage"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4408f971-7930-41ea-9f93-b01231e40861}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
