{
  "manifest_version": 3,
  "name": "Foxy",
  "version": "4.1.0",
  "description": "A board of your tabs, tab groups and pinned tabs, saved as bookmarks and synced across devices.",
  "icons": { "48": "icons/foxy.svg", "96": "icons/foxy.svg" },
  "permissions": ["tabs", "tabGroups", "bookmarks", "storage", "scripting", "nativeMessaging"],
  "optional_permissions": ["geolocation"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": { "page": "options.html" },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4408f971-7930-41ea-9f93-b01231e40861}",
      "update_url": "https://github.com/guru-irl/foxy/releases/latest/download/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["locationInfo"]
      }
    }
  }
}
